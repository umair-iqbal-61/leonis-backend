// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Workspace {
  PETS
  LIVESTOCK
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  email String? @unique
  emailVerifiedAt DateTime?
  pendingEmail String?
  requiresEmailVerification Boolean @default(false)
  verificationTokenHash String? @unique
  verificationExpiresAt DateTime?
  passwordResetTokenHash String? @unique
  passwordResetExpiresAt DateTime?
  sessionVersion Int @default(0)
  pets     Pet[]
  listings Listing[]
  isStoreAdmin Boolean @default(false)
  products Product[]
  orders StoreOrder[]
  barns Barn[]
  workspaces Workspace[] @default([PETS])
  activeWorkspace Workspace @default(PETS)
}

model Pet {
  id        Int        @id @default(autoincrement())
  name      String
  species   String
  gender    String?
  breed     String?
  age       Int?
  weight    Decimal?
  notes     String?
  avatarUrl String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  meals     Meal[]
  weights   Weight[]
  vetVisits VetVisit[]
  reminders Reminder[]
  photos    Photo[]
  dairyRecords DairyRecord[]
  qualityFindings QualityFinding[]
  barnMemberships BarnMembership[]
  barnEntries BarnEntry[]
  userId    Int
  user      User       @relation(fields: [userId], references: [id])
}

model Meal {
  id        Int      @id @default(autoincrement())
  name      String
  amount    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  petId     Int
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model Weight {
  id        Int      @id @default(autoincrement())
  weight    Decimal
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  petId     Int
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model VetVisit {
  id        Int       @id @default(autoincrement())
  reason    String
  vetName   String?
  visitDate DateTime
  nextVisit DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  petId     Int
  pet       Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model Reminder {
  id        Int      @id @default(autoincrement())
  title     String
  type      String
  remindAt  DateTime @db.Time()
  days      String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  petId     Int
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model Photo {
  id         Int      @id @default(autoincrement())
  url        String
  storageKey String
  title      String?
  size       Int?
  createdAt  DateTime @default(now())
  petId      Int
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
}

enum DairyRecordKind {
  MILK_YIELD
  BREEDING
  CALVING
}

enum QualityStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

model DairyRecord {
  id            Int             @id @default(autoincrement())
  petId         Int
  pet           Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  kind          DairyRecordKind
  recordedOn    DateTime        @db.Date
  liters        Decimal?
  session       String?
  notes         String?
  @@index([petId, recordedOn])
}

model QualityFinding {
  id             Int           @id @default(autoincrement())
  petId          Int
  pet            Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  fingerprint    String
  evidence       String
  ruleId         String
  dimension      String
  severity       String
  records        Json
  explanationKey String
  parameters     Json
  status         QualityStatus @default(OPEN)
  active         Boolean       @default(true)
  reviewedAt     DateTime?
  @@unique([petId, fingerprint])
  @@index([petId, active])
}


enum ListingStatus {
  DRAFT
  PUBLISHED
  SOLD
}

model Listing {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id])
  title          String
  description    String
  species        String
  breed          String?
  age            Int?
  price          Decimal       @db.Decimal(12, 2)
  location       String
  phone          String
  whatsapp       String
  status         ListingStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime?
  photos         ListingPhoto[]
  @@index([status, publishedAt, id])
  @@index([userId, updatedAt])
}

model ListingPhoto {
  id         Int     @id @default(autoincrement())
  listingId  Int
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url        String
  storageKey String
  @@index([listingId])
}


enum StoreOrderStatus {
  PENDING
  AWAITING_QUOTE
  AWAITING_ACCEPTANCE
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryMode {
  STANDARD
  QUOTE
}

model Product {
  id            Int @id @default(autoincrement())
  sellerId      Int
  seller        User @relation(fields: [sellerId], references: [id])
  name          String
  description   String
  category      String
  species       String[]
  price         Decimal @db.Decimal(12, 2)
  stock         Int @default(0)
  weightGrams   Int
  requiresQuote Boolean @default(false)
  active        Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  photos        ProductPhoto[]
  orderItems    StoreOrderItem[]
  @@index([active, category, id])
}

model ProductPhoto {
  id         Int @id @default(autoincrement())
  productId  Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  storageKey String
  @@index([productId])
}

model StoreSettings {
  id                       Int @id @default(1)
  standardFee              Decimal? @db.Decimal(12, 2)
  standardWeightLimitGrams Int?
  checkoutEnabled          Boolean @default(false)
  updatedAt                DateTime @updatedAt
}

model StoreOrder {
  id            Int @id @default(autoincrement())
  userId        Int
  user          User @relation(fields: [userId], references: [id])
  requestId     String
  status        StoreOrderStatus
  deliveryMode  DeliveryMode
  subtotal      Decimal @db.Decimal(14, 2)
  shippingFee   Decimal? @db.Decimal(12, 2)
  total         Decimal? @db.Decimal(14, 2)
  weightGrams   Int
  quoteVersion  Int @default(0)
  recipientName String
  phone         String
  address       String
  city          String
  province      String
  postalCode    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         StoreOrderItem[]
  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model StoreOrderItem {
  id          Int @id @default(autoincrement())
  orderId     Int
  order       StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product @relation(fields: [productId], references: [id])
  name        String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(14, 2)
  weightGrams Int
  @@index([orderId])
}


model Barn {
  id        Int @id @default(autoincrement())
  userId    Int
  user      User @relation(fields: [userId], references: [id])
  requestId String
  name      String
  location  String?
  notes     String?
  archived  Boolean @default(false)
  version   Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships BarnMembership[]
  entries   BarnEntry[]
  @@unique([userId, requestId])
  @@index([userId, archived])
}

model BarnMembership {
  id              Int @id @default(autoincrement())
  barnId          Int
  barn            Barn @relation(fields: [barnId], references: [id])
  petId           Int?
  pet             Pet? @relation(fields: [petId], references: [id], onDelete: SetNull)
  animalReference Int
  animalName      String
  requestId       String
  startedOn       DateTime @db.Date
  endedOn         DateTime? @db.Date
  @@unique([animalReference, requestId])
  @@index([barnId, startedOn])
  @@index([petId, endedOn])
}

model BarnEntry {
  id              Int @id @default(autoincrement())
  barnId          Int
  barn            Barn @relation(fields: [barnId], references: [id])
  petId           Int?
  pet             Pet? @relation(fields: [petId], references: [id], onDelete: SetNull)
  animalReference Int?
  animalName      String?
  requestId       String
  occurredOn      DateTime @db.Date
  category        String
  amount          Decimal @db.Decimal(14, 2)
  quantity        Decimal? @db.Decimal(12, 3)
  unit            String?
  description     String
  receipt         String?
  version         Int @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        BarnPayment[]
  @@unique([barnId, requestId])
  @@index([barnId, occurredOn])
  @@index([barnId, animalReference])
}

model BarnPayment {
  id          Int @id @default(autoincrement())
  entryId     Int
  entry       BarnEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  requestId   String
  paidOn      DateTime @db.Date
  amount      Decimal @db.Decimal(14, 2)
  note        String?
  @@unique([entryId, requestId])
  @@index([entryId, paidOn])
}
